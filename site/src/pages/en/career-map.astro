---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  lang="en"
  frSlug="carte-carriere"
  navLight={true}
  title="Maritime career map | Colomban"
  description="Interactive map of Colomban Monnier's voyages: vessels, port calls and real sea routes. Drop your own sea service record to generate your own."
>
  <section class="cc-page">
    <iframe
      src={`${base}/voyages/index.html?lang=en`}
      class="cc-frame"
      title="Maritime career map, interactive application"
      loading="eager"
    ></iframe>
  </section>
</BaseLayout>

<style>
  .cc-page {
    position: fixed;
    top: var(--nav-height);
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--blanc);
    z-index: 1;
  }
  .cc-frame {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
